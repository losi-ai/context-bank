{
  "name": "@losi-ai/ollama",
  "version": "0.1.0",
  "description": "Ollama (local) adapter for Losi Context Bank. Give local models persistent business context and switch models without losing it.",
  "license": "MIT",
  "homepage": "https://losi.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/losi-ai/context-bank.git",
    "directory": "packages/ollama"
  },
  "keywords": [
    "ollama",
    "local llm",
    "llm context",
    "ai memory",
    "multi-llm",
    "llm switching",
    "context bank"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@losi-ai/core": "^0.1.0"
  },
  "dependencies": {
    "ollama": "^0.5.9"
  },
  "devDependencies": {
    "@losi-ai/core": "^0.1.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
