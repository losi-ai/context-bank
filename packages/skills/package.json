{
  "name": "@losi/skills",
  "version": "0.1.0",
  "description": "Reusable multi-step agent skills for Losi Context Bank — define, install, and run skills with parameterized steps.",
  "license": "MIT",
  "homepage": "https://losi.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/marshmallow-studio/losi-context-bank.git",
    "directory": "packages/skills"
  },
  "keywords": [
    "ai agent context",
    "ai skills",
    "llm context",
    "agent workflow",
    "context bank"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@losi/core": "^0.1.0"
  },
  "devDependencies": {
    "@losi/core": "^0.1.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
