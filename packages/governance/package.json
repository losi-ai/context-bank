{
  "name": "@losi-ai/governance",
  "version": "0.1.0",
  "description": "AI governance policy engine for Losi Context Bank — per-agent spend caps, rate limits, blocked actions, data scopes, audit log, and kill switch.",
  "license": "MIT",
  "homepage": "https://losi.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/losi-ai/losi-context-bank.git",
    "directory": "packages/governance"
  },
  "keywords": [
    "ai governance",
    "ai agent context",
    "llm context",
    "audit log",
    "spend cap",
    "context bank"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@losi-ai/core": "^0.1.0"
  },
  "devDependencies": {
    "@losi-ai/core": "^0.1.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
