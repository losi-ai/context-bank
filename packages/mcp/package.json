{
  "name": "@losi-ai/mcp",
  "version": "0.1.0",
  "description": "MCP (Model Context Protocol) client adapter for Losi Context Bank with per-tool data access scopes and governance enforcement.",
  "license": "MIT",
  "homepage": "https://losi.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/losi-ai/context-bank.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "mcp adapter",
    "model context protocol",
    "ai governance",
    "ai agent context",
    "llm context",
    "context bank"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@losi-ai/core": "^0.1.0"
  },
  "devDependencies": {
    "@losi-ai/core": "^0.1.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
